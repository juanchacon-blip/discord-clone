DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discord_clone"
FRONTEND_URL=http://localhost:5173
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://discord-clone-api

# --- Respaldo en Google Drive (opcional; si falta algo, el boton de Drive no aparece) ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# Debe ser EXACTAMENTE igual a la "URI de redireccionamiento" que registres en Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3000/drive/callback
# Texto largo y aleatorio (32+ caracteres). Cifra los tokens de Drive en la base de datos.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Almacenamiento del proyecto (opcional en local; OBLIGATORIO en Render gratis) ---
# Sin esto las fotos se guardan en el disco del servidor y se pierden al reiniciar.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=chat-files
