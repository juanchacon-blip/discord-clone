generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Channel {
  id        Int       @id @default(autoincrement())
  name      String
  messages  Message[]
  roles     ChannelRole[]
  reads     ChannelRead[]
  createdAt DateTime  @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  author    String
  fileName  String?
  fileUrl   String?
  // Archivos: tipo verificado, clave en el almacenamiento del proyecto y estado del respaldo en Drive
  mimeType    String?
  storageKey  String?
  authorSub   String?
  driveStatus String?   // OBSOLETO: ahora el respaldo de cada cuenta se guarda en DriveBackup
  driveFileId String?
  backups     DriveBackup[]
  channelId Int
  channel   Channel  @relation(fields: [channelId], references: [id])
  createdAt DateTime @default(now())
}

model Role {
  id       Int           @id @default(autoincrement())
  name     String        @unique
  users    User[]
  channels ChannelRole[]
}

// Si un canal no tiene filas aqui, lo ven todos. Si tiene, solo esos roles (y el administrador).
model ChannelRole {
  channelId Int
  roleId    Int
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([channelId, roleId])
}

model User {
  id        Int      @id @default(autoincrement())
  sub       String   @unique
  name      String
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// Una fila por cuenta (Auth0 "sub") que conecto su Google Drive para respaldar sus archivos.
model DriveConnection {
  sub          String   @id
  email        String?
  refreshToken String   // cifrado (AES-256-GCM)
  folderId     String?
  createdAt    DateTime @default(now())
}

// Hasta que mensaje leyo cada cuenta en cada canal (sirve para la "bolita" de mensajes sin leer).
model ChannelRead {
  sub        String
  channelId  Int
  lastReadId Int     @default(0)
  channel    Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([sub, channelId])
}

// Copia de una imagen en el Drive de una cuenta. Una fila por (cuenta, mensaje).
// status: 'pending' | 'ok' | 'failed' | 'missing' (el archivo original ya no existe)
model DriveBackup {
  sub         String
  messageId   Int
  status      String
  driveFileId String?
  createdAt   DateTime @default(now())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([sub, messageId])
  @@index([messageId])
}

// Nombre que cada cuenta eligio para mostrar en el chat.
model Profile {
  sub         String   @id
  displayName String
  nameKey     String   @unique // en minusculas y sin tildes: evita dos nombres "iguales" (Jose / josé)
  updatedAt   DateTime @updatedAt
}
